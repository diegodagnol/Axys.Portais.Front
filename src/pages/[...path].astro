---
import BaseLayout from '../layouts/BaseLayout.astro';
import AxysHtml from '../portal/content/AxysHtml.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import NotFound from '../components/NotFound.astro';
import Cta from '../components/Cta.astro';
import CtaSection from '../components/CtaSection.astro';
import Location from '../components/Location.astro';
import { resolveRoute } from '../portal/api/queries';
import { pageSeo } from '../portal/seo/seo';
import { cmsSources } from '../data/home';

// Páginas de conteúdo do CMS: a API resolve o caminho (ADR-014).
const { site, host } = Astro.locals;
const path = `/${Astro.params.path ?? ''}`;
const route = await resolveRoute(host, path);

if (route?.tipo === 'redirecionamento') {
  return Astro.redirect(route.destino, route.permanente ? 301 : 302);
}

const page = route?.tipo === 'pagina' ? route.pagina : null;
if (!page) {
  Astro.response.status = 404;
}
const seo = page?.seo ?? pageSeo(site, { title: 'Página não encontrada', path, index: false });
---

<BaseLayout seo={seo}>
  {page ? (
    <>
      <section class="page-header" data-source={cmsSources.pages.kind}>
        <p class="section__source">{cmsSources.pages.label}</p>
        <div class="container stack">
          <Breadcrumb items={page.migalhas} />
          <h1>{page.titulo}</h1>
          {page.subtitulo && <p class="page-header__subtitle">{page.subtitulo}</p>}
          <Cta />
        </div>
      </section>

      <article class="section" data-source={cmsSources.pageContent.kind}>
        <p class="section__source">{cmsSources.pageContent.label}</p>
        <div class="container container--text">
          <AxysHtml html={page.apresentacaoHtml} />
        </div>
      </article>

      <CtaSection />
      <Location />
    </>
  ) : (
    <NotFound />
  )}
</BaseLayout>
