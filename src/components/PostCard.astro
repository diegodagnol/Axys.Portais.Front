---
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { PostSummary } from '../portal/api/client';
import { formatDate } from '../portal/format';

interface Props {
  post: PostSummary;
}

const { post } = Astro.props;
const { site } = Astro.locals;
---

<article class="card">
  <ImagePlaceholder label="Imagem de capa" ratio="16 / 10" />
  <p class="card__meta">
    <a href={post.categoria.url}>{post.categoria.nome}</a> ·
    <time datetime={post.publicadaEmUtc}>{formatDate(post.publicadaEmUtc, site.cultura)}</time>
  </p>
  <h3 class="card__title"><a href={post.url}>{post.titulo}</a></h3>
  {post.resumo && <p class="card__text">{post.resumo}</p>}
  <a class="card__more" href={post.url} aria-hidden="true" tabindex="-1">Saiba mais →</a>
</article>
