{
  "name": "axys-portais-front",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo de front-end do site público Axys.Portal: pacote @axys/portal e sites (ADR-018).",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "types": "npm run types -w @axys/portal",
    "contract:update": "npm run contract:update -w @axys/portal",
    "mock": "node mock/server.mjs",
    "mock:contract": "prism mock packages/portal/contract/openapi-v1.json --port 4011",
    "predev": "npm run types",
    "dev": "npm run dev -w demo",
    "prebuild": "npm run types",
    "build": "npm run build -w demo",
    "check": "npm run types && npm run check -w demo",
    "start": "npm run start -w demo"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.16.0"
  }
}
