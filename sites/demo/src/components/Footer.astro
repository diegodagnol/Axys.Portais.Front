---
import Menu from './Menu.astro';
import { getMenu } from '@axys/portal/api';
import { location } from '../data/home';

const { site, host } = Astro.locals;
const footerMenu = await getMenu(host, 'rodape');
const phones = site.contato.telefones.filter((phone) => phone.exibirNoRodape);
const whatsapp = site.contato.telefones.find((phone) => phone.exibirNoBalaoWhatsApp && phone.linkWhatsApp);
const socialLinks = [
  ['Instagram', site.redesSociais.instagram],
  ['Facebook', site.redesSociais.facebook],
  ['LinkedIn', site.redesSociais.linkedin],
  ['YouTube', site.redesSociais.youtube],
  ['TikTok', site.redesSociais.tiktok],
  ['X', site.redesSociais.x],
].filter((link): link is [string, string] => Boolean(link[1]));
---

<footer class="footer">
  <div class="footer__grid container">
    <div>
      <p class="footer__logo">[ Logo ]</p>
      {socialLinks.length > 0 && (
        <ul class="footer__social">
          {socialLinks.map(([network, url]) => (
            <li><a href={url} target="_blank" rel="noopener">{network}</a></li>
          ))}
        </ul>
      )}
    </div>

    {footerMenu && (
      <nav aria-label={footerMenu.nome}>
        <Menu items={footerMenu.itens} />
      </nav>
    )}

    <address class="footer__contact">
      {phones.map((phone) => (
        <a href={phone.linkWhatsApp ?? `tel:${phone.numero}`}>{phone.rotulo ?? 'Telefone'}: {phone.numeroFormatado}</a>
      ))}
      {site.contato.email && <a href={`mailto:${site.contato.email}`}>{site.contato.email}</a>}
      <span>{location.address}</span>
    </address>
  </div>
  <p class="footer__copyright container">© {new Date().getFullYear()}</p>

  {whatsapp && (
    <a class="whatsapp-button" href={whatsapp.linkWhatsApp} target="_blank" rel="noopener" data-no-prerender>
      WhatsApp
    </a>
  )}
</footer>
