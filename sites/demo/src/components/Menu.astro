---
import type { MenuItem } from '@axys/portal/api';

interface Props {
  items: MenuItem[];
  level?: number;
}

const { items, level = 1 } = Astro.props;
---

<ul class:list={['menu', `menu--level-${level}`]}>
  {items.map((item) => (
    <li class="menu__item">
      {item.link ? (
        <a
          class="menu__link"
          href={item.link.url}
          target={item.link.novaJanela ? '_blank' : undefined}
          rel={item.link.novaJanela ? 'noopener' : undefined}
        >
          {item.titulo}
        </a>
      ) : (
        <span class="menu__link">{item.titulo}</span>
      )}
      {item.filhos.length > 0 && <Astro.self items={item.filhos} level={level + 1} />}
    </li>
  ))}
</ul>
