---
/**
 * Topo da home em largura total (full bleed) a partir dos banners principais do CMS.
 * Um banner: imagem e texto. Vários: carrossel <axys-carousel> (src/scripts/carousel.ts) sobre um trilho com
 * scroll-snap — sem JavaScript continua rolável; com ele, setas, indicadores, troca automática e pausa.
 */
import Cta from './Cta.astro';
import type { Banner } from '@axys/portal/api';
import { cmsSources } from '../data/home';

interface Props {
  banners: Banner[];
}

const { banners } = Astro.props;
const isCarousel = banners.length > 1;
---

<section class="hero" data-source={cmsSources.banners.kind} aria-roledescription={isCarousel ? 'carrossel' : undefined} aria-label="Destaques">
  <p class="section__source">{cmsSources.banners.label}</p>

  {banners.length === 0 ? (
    <div class="hero__slide">
      <div class="hero__media hero__media--placeholder" aria-hidden="true"></div>
      <div class="hero__content container">
        <h1 class="hero__headline">Lorem ipsum dolor sit amet</h1>
        <Cta />
      </div>
    </div>
  ) : (
    <axys-carousel>
      <ul class="hero__track" data-carousel-track>
        {banners.map((banner, i) => {
          const image = banner.imagem;
          return (
            <li
              class="hero__slide"
              data-interval={banner.tempoTransicaoSegundos}
              aria-roledescription={isCarousel ? 'slide' : undefined}
              aria-label={isCarousel ? `${i + 1} de ${banners.length}` : undefined}
            >
              {image ? (
                <picture class="hero__media">
                  {image.mobile && <source media="(max-width: 767px)" srcset={image.mobile.url} />}
                  <img
                    src={image.desktop.url}
                    alt={image.desktop.alt}
                    width={image.desktop.largura}
                    height={image.desktop.altura}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : undefined}
                    decoding="async"
                  />
                </picture>
              ) : (
                <div class="hero__media hero__media--placeholder" aria-hidden="true"></div>
              )}
              <div class="hero__content container">
                {i === 0 ? (
                  <h1 class="hero__headline">{banner.chamadaPrincipal ?? banner.titulo}</h1>
                ) : (
                  <p class="hero__headline">{banner.chamadaPrincipal ?? banner.titulo}</p>
                )}
                {banner.chamadaSecundaria && <p class="hero__subheadline">{banner.chamadaSecundaria}</p>}
                {banner.link && banner.textoBotao ? (
                  <a
                    class="button button--primary"
                    href={banner.link.url}
                    target={banner.link.novaJanela ? '_blank' : undefined}
                    rel={banner.link.novaJanela ? 'noopener' : undefined}
                  >
                    {banner.textoBotao}
                  </a>
                ) : (
                  <Cta />
                )}
              </div>
            </li>
          );
        })}
      </ul>

      {isCarousel && (
        <div class="carousel__controls">
          <button class="carousel__arrow carousel__arrow--prev" type="button" data-carousel-prev aria-label="Destaque anterior">‹</button>
          <button class="carousel__arrow carousel__arrow--next" type="button" data-carousel-next aria-label="Próximo destaque">›</button>
          <div class="carousel__bottom container">
            <div class="carousel__dots" data-carousel-dots></div>
            <button class="carousel__toggle" type="button" data-carousel-toggle>Pausar</button>
          </div>
        </div>
      )}
    </axys-carousel>
  )}
</section>

{isCarousel && <script>import '../scripts/carousel';</script>}
