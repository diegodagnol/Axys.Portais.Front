# Copie para .env no desenvolvimento. Em servidores, use variáveis de ambiente (nunca arquivo versionado).

# API pública de conteúdo. Com o mock local (npm run mock): http://localhost:4010/v1
AXYS_API_URL=http://localhost:4010/v1

# Chave do consumidor. O mock aceita qualquer valor não vazio.
AXYS_API_KEY=chave-de-desenvolvimento # gitleaks:allow

# Só no desenvolvimento: host enviado à API no lugar do host da requisição (localhost não é host de site).
AXYS_FIXED_HOST=localhost

# Formulário da página /fale-conosco (enquanto não existe o vínculo por bloco, ADR-020 D1).
AXYS_CONTACT_FORM_ID=0192a3b4-0000-7000-8000-00000000f001

# Assinatura do carimbo de tempo dos formulários. Troque em cada ambiente.
AXYS_FORM_SECRET=troque-este-valor-em-cada-ambiente # gitleaks:allow
